[Unit]
Description=AmneziaWG server for VPN clients (awg0, UDP 443)
After=network-online.target
Wants=network-online.target
# Without the routes unit client traffic would be neither marked nor
# filtered. Ordered after it by the routes unit's Before=.
Requires=vpn-routes.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Only root writes awg0.conf (vpn-peer checks it has no hook lines before
# each write), so awg-quick reads it directly.
ExecStartPre=-/usr/bin/awg-quick down awg0
ExecStart=/usr/bin/awg-quick up awg0
ExecStop=/usr/bin/awg-quick down awg0
# a failed start (the network not ready at boot) is tried again
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
