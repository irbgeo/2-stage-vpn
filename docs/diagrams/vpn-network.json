  "cards": [
    {
      "dot": "rose",
      "title": "Fail-closed",
      "items": [
        "Tunnel down: only the unreachable route is left in table 100, clients have no internet",
        "ip rule gone: vpn_forward drops a marked packet that does not leave via awg-exit",
        "The self-check restores the rule, the routes and the nft table within 15 s"
      ]
    },
    {
      "dot": "amber",
      "title": "Guards",
      "items": [
        "Clients do not see each other",
        "Private networks and 169.254.169.254 are closed on both servers",
        "On the entry server clients reach only DNS and ping",
        "Client IPv6 is dropped"
      ]
    },
    {
      "dot": "cyan",
      "title": "DNS without leaks",
      "items": [
        "unbound answers clients on 10.8.0.1",
        "Its own queries (DoT to 1.1.1.1) get mark 0x1, so they leave through the exit server"
      ]
    }
  ]
